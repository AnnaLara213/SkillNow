<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Client-side validation for the Training Date field. It triggers an asynchronous GlideAjax call to the TrainingCheckUtils script include whenever the training date or course is changed. If a conflict is detected (i.e., the course is already scheduled for that date), it clears the field, displays an error message, and alerts the user to prevent duplicate bookings.</description>
        <field>training_date</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>Check Duplicate Schedule on Change</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var course = g_form.getValue('course');
    if (course == '') {
        // Se não tiver curso, não tem como validar duplicata ainda
        return;
    }

    // 1. Verifique se este API Name está IGUAL ao do seu Script Include
    var ga = new GlideAjax('x_1974477_skillnow.TrainingCheckUtils'); 
    ga.addParam('sysparm_name', 'checkDuplicateSchedule');
    ga.addParam('sysparm_course', course);
    ga.addParam('sysparm_date', newValue);
    ga.addParam('sysparm_sys_id', g_form.getUniqueValue());

    ga.getXMLAnswer(function(answer) {
        // Este alert vai nos dizer o que o servidor respondeu
        // Se vier vazio ou erro, saberemos que o Script Include falhou
        if (answer === "true") {
            g_form.clearValue('training_date');
            g_form.showFieldMsg('training_date', 'Duplicate: This course is already scheduled for this date.', 'error');
            alert('Erro: Já existe um treinamento para este curso nesta data!');
        } else {
            // Se cair aqui, o servidor respondeu "false" ou algo inesperado
            alert('Resposta do servidor: ' + answer);
        }
    });
}]]></script>
